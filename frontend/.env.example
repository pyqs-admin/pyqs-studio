# Dedicated Content Studio Supabase project only. Never use the public PYQS project.
NEXT_PUBLIC_STUDIO_SUPABASE_URL=https://your-studio-project.supabase.co
NEXT_PUBLIC_STUDIO_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me

# Server-only configuration (never prefixed with NEXT_PUBLIC_).
DATABASE_URL=postgresql://postgres:password@localhost:5432/pyqs_content_studio
SUPABASE_URL=https://your-studio-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=sb_secret_replace_me
STUDIO_MEDIA_BUCKET=studio-media
PYQS_PUBLISHING_WEBHOOK_URL=https://api.pyqs.com/internal/studio/publish
PYQS_PUBLISHING_WEBHOOK_SECRET=replace-with-a-unique-long-secret

# Initial admin provisioning (seed).
STUDIO_INITIAL_ADMIN_ID=
STUDIO_INITIAL_ADMIN_EMAIL=
STUDIO_INITIAL_ADMIN_NAME=
