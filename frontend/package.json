{
  "name": "pyqs-content-studio-frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:seed": "tsx src/server/db/seed.ts",
    "db:seed:taxonomy": "tsx src/server/db/seed-taxonomy.ts",
    "seed:neet-pg": "tsx src/server/db/migrations/neet-pg/seed.ts",
    "validate:neet-pg-migration": "tsx src/server/db/migrations/neet-pg/validate.ts",
    "seed:upsc-cms": "tsx src/server/db/migrations/neet-pg/seed.ts --exam upsc-cms",
    "validate:upsc-cms-migration": "tsx src/server/db/migrations/neet-pg/validate.ts --exam upsc-cms",
    "db:push": "drizzle-kit push",
    "db:push:preview": "drizzle-kit push --explain --verbose"
  },
  "dependencies": {
    "@hookform/resolvers": "^3.10.0",
    "@radix-ui/react-checkbox": "^1.3.11",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-slot": "^1.1.1",
    "@radix-ui/react-switch": "^1.3.7",
    "@supabase/ssr": "^0.5.2",
    "@supabase/supabase-js": "^2.49.1",
    "@tanstack/react-query": "^5.66.8",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "docx": "^9.7.1",
    "dotenv": "17.3.1",
    "drizzle-orm": "1.0.0-rc.4",
    "image-size": "^2.0.4",
    "lucide-react": "^0.468.0",
    "next": "^15.1.6",
    "pg": "8.19.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.54.2",
    "server-only": "0.0.1",
    "sharp": "^0.35.4",
    "tailwind-merge": "^2.6.0",
    "zod": "^3.24.2",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@types/node": "^22.13.4",
    "@types/pg": "8.18.0",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "autoprefixer": "^10.4.20",
    "drizzle-kit": "1.0.0-rc.4",
    "eslint": "^9.19.0",
    "eslint-config-next": "^15.1.6",
    "postcss": "^8.5.1",
    "tailwindcss": "^3.4.17",
    "tsx": "4.21.0",
    "typescript": "^5.7.3",
    "vitest": "4.0.18"
  },
  "packageManager": "pnpm@10.30.3"
}
