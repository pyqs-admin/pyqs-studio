{
  "info": {
    "_postman_id": "a8afeb4c-9164-4b87-a163-6d75264d2f83",
    "name": "PYQS Content Studio Backend",
    "description": "Endpoints implemented in the PYQS Content Studio backend. Set `baseUrl` and `studioAccessToken` in the collection variables before calling authenticated endpoints.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8100",
      "type": "string"
    },
    {
      "key": "studioAccessToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "examId",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "System",
      "item": [
        {
          "name": "Service Health",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/health",
              "host": ["{{baseUrl}}"],
              "path": ["health"]
            }
          },
          "response": []
        },
        {
          "name": "API and Database Health",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/health",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "health"]
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "Authentication",
      "item": [
        {
          "name": "Current Studio User",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{studioAccessToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/me",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "auth", "me"]
            },
            "description": "Requires a token issued by the dedicated Studio Supabase project and an active, pre-provisioned `studio_profile`."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Taxonomy",
      "item": [
        {
          "name": "Get Full Taxonomy",
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{studioAccessToken}}", "type": "string" }] },
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/v1/taxonomy", "host": ["{{baseUrl}}"], "path": ["api", "v1", "taxonomy"] }
          },
          "response": []
        },
        {
          "name": "List Subjects",
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{studioAccessToken}}", "type": "string" }] },
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/v1/taxonomy/subjects", "host": ["{{baseUrl}}"], "path": ["api", "v1", "taxonomy", "subjects"] }
          },
          "response": []
        },
        {
          "name": "Create Subject",
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{studioAccessToken}}", "type": "string" }] },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"code\": \"pathology\",\n  \"name\": \"Pathology\",\n  \"sortOrder\": 1\n}" },
            "url": { "raw": "{{baseUrl}}/api/v1/taxonomy/subjects", "host": ["{{baseUrl}}"], "path": ["api", "v1", "taxonomy", "subjects"] },
            "description": "Requires the taxonomy.manage permission."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Projects",
      "item": [
        {
          "name": "List Accessible Projects",
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{studioAccessToken}}", "type": "string" }] },
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/v1/projects", "host": ["{{baseUrl}}"], "path": ["api", "v1", "projects"] }
          },
          "response": []
        },
        {
          "name": "Create Project",
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{studioAccessToken}}", "type": "string" }] },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"INI-CET November 2026\",\n  \"examId\": \"{{examId}}\",\n  \"year\": 2026,\n  \"session\": \"November\"\n}" },
            "url": { "raw": "{{baseUrl}}/api/v1/projects", "host": ["{{baseUrl}}"], "path": ["api", "v1", "projects"] },
            "description": "Requires project.create. The creator is automatically added as Project Owner."
          },
          "response": []
        }
      ]
    }
  ]
}
